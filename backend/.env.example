# Read-only connection to the main send-invite.online MongoDB instance.
MONGODB_URI=mongodb://dashboard_readonly:password@host:27017/?authSource=invite
MONGODB_DB=invite

# Single admin account for the dashboard.
ADMIN_EMAIL=admin@send-invite.online
# bcrypt hash — generate with: node -e "console.log(require('bcryptjs').hashSync('your-password', 10))"
ADMIN_PASSWORD_HASH=

JWT_SECRET=change-me-to-a-long-random-string

# Used to build public links to invite sites in the order detail view.
SITE_BASE_URL=https://send-invite.online

# Optional: ad spend enrichment via Yandex Direct API v5 Reports.
# Get a token at https://oauth.yandex.ru/authorize?response_type=token&client_id=<APP_ID>
# after registering an app at https://oauth.yandex.ru/client/new with "Яндекс.Директ API" access.
# YANDEX_DIRECT_OAUTH_TOKEN=
# Only needed for agency-managed accounts (Client-Login header).
# YANDEX_DIRECT_CLIENT_LOGIN=

PORT=4000
CORS_ORIGIN=http://localhost:5173
